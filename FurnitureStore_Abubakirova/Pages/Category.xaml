<Page x:Class="FurnitureStore_Abubakirova.Pages.Category"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FurnitureStore_Abubakirova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Category">

    <Grid Background="BlanchedAlmond">
        <Label Content="Категории" HorizontalAlignment="Center" Margin="0,21,0,0" VerticalAlignment="Top" Width="434" HorizontalContentAlignment="Center"
               FontWeight="Bold" FontSize="28"/>
        <ComboBox x:Name="combo" HorizontalAlignment="Center" Margin="0,94,0,0" VerticalAlignment="Top" Width="120" SelectionChanged="combo_SelectionChanged"  >

        </ComboBox>
        <ScrollViewer Margin="0,138,0,39" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="parent"  Orientation="Horizontal" >
            </StackPanel>
        </ScrollViewer>
        
        <Button Content="На главную" HorizontalAlignment="Left" Margin="20,28,0,0" VerticalAlignment="Top" Width="132" Height="24" Click="Button_Click"/>
    </Grid>
</Page>
